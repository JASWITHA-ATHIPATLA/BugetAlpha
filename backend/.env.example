# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/expense-tracker

# JWT secret used to sign auth tokens (use a long random string in production)
JWT_SECRET=a3d4f9e1c8b7a6d5f4e3c2b1a9f8d7c6b5a4e3d2c1b0f9e8d7c6b5a4e3d2c1b0f9e8d7c6b5a4e3d2c1b0f9e8d7c6

# JWT token expiry
JWT_EXPIRES_IN=7d

# Port the backend server runs on
PORT=5000

# Frontend origin(s) allowed by CORS. Comma-separate multiple origins,
# e.g. "http://localhost:5173,https://your-app.vercel.app"
CLIENT_URL=http://localhost:5173
